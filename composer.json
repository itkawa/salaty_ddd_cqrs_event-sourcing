{
    "name": "alcor/payroll-poc",
    "description": "PoC: history of manual adjustments to an earning line (DDD + CQRS + Event Sourcing).",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*"
    },
    "autoload": {
        "psr-4": {
            "Payroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payroll\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "demo": "php bin/payroll-demo.php",
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
